# Shared environment for docker compose services

# Proxy
PROXY_PORT=8080

# Server
PORT=8031
NODE_ENV=development
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=900000
REFRESH_TOKEN_EXPIRES_IN=2592000000
HASH_SALT=10
CORS_ORIGINS=http://localhost:8080

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tester
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tester?schema=public

# Client (build-time Vite vars; same-origin via proxy)
VITE_API_URL=/api
VITE_SERVER_URL=
VITE_WS_URL=ws://localhost:8080/ws
